{#
 # The edit page title. A resource that implements AdminRecordInterface names
 # itself (its title rather than "Edit book") and shows its state as a pill;
 # else the title is read from `<application>.ui.edit_<resource>` when it is
 # translated ("Nouvelle page"), or composed as Sylius does.
 #}
{% import '@SyliusBootstrapAdminUi/shared/helper/header.html.twig' as header %}

{% set metadata = hookable_metadata.context.metadata|default(null) %}
{% set resource = hookable_metadata.context.resource|default(null) %}
{% set record = resource is not null and resource.adminLabel is defined ? resource : null %}
{% set singular_name = hookable_metadata.configuration.resource_name|default(metadata is not null ? metadata.applicationName ~ '.ui.' ~ metadata.name : null) %}
{% set title = hookable_metadata.configuration.title|default(hookable_metadata.configuration.header|default(null)) %}

{% if title is null and metadata is not null %}
    {% set key = metadata.applicationName ~ '.ui.edit_' ~ metadata.name %}
    {% if key|trans != key %}{% set title = key|trans %}{% endif %}
{% elseif title is not null %}
    {% set title = title|trans %}
{% endif %}
{% if record is not null and record.adminLabel is not empty %}
    {% set title = record.adminLabel %}
{% endif %}

{% set icon = hookable_metadata.configuration.icon|default(null) %}
{% set subheader = hookable_metadata.configuration.subheader|default(null) %}

<div class="col-12 col-md-7">
    <div class="d-flex flex-wrap gap-3 align-items-center ddd-title">
        {{ header.h1(title is not null ? title : 'sylius.ui.edit'|trans ~ ' ' ~ singular_name|trans, icon, subheader|trans) }}
        {% if record is not null %}{{ admin_status(record.adminStatus) }}{% endif %}
    </div>
</div>

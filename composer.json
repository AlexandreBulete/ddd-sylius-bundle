{
    "name": "alexandrebulete/ddd-sylius-bundle",
    "description": "Sylius Stack Bundle for DDD Foundation - Admin UI, Grid, Resource integration",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandre Bulete"
        }
    ],
    "require": {
        "php": "^8.2",
        "alexandrebulete/ddd-symfony-bundle": "^1.1",
        "knplabs/knp-menu-bundle": "^3.0",
        "sylius/resource-bundle": "^1.11",
        "sylius/grid-bundle": "^1.13",
        "sylius/admin-ui": "^0.10",
        "sylius/bootstrap-admin-ui": "^0.10"
    },
    "autoload": {
        "psr-4": {
            "AlexandreBulete\\DddSyliusBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexandreBulete\\DddSyliusBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

